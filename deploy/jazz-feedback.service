# /etc/systemd/system/jazz-feedback.service  (app container)
[Unit]
Description=Jazz piano coach feedback API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jazzfb
Group=jazzfb
Environment=PORT=8090
Environment=CLAIR_FEEDBACK_DIR=/var/lib/jazz-feedback
ExecStart=/usr/bin/python3 /opt/jazz-feedback/feedback_api.py
Restart=on-failure
RestartSec=3
StateDirectory=jazz-feedback
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jazz-feedback
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target
